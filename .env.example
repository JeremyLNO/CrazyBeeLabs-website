# ─────────────────────────────────────────────────────────────
# Crazy Bee Labs — environment variables
# Copy to .env.local for local dev, and set the same in Vercel.
# Everything related to a third-party tool is INACTIVE until filled.
# ─────────────────────────────────────────────────────────────

# Database — Neon Postgres (https://neon.tech)
# Use the pooled connection string for serverless.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js (https://authjs.dev) — generate with: openssl rand -base64 32
AUTH_SECRET=""
# On Vercel this is detected automatically; locally keep the dev URL.
AUTH_URL="http://localhost:3000"
# Allow sign-in before the email is verified. Keep "true" until Brevo is live,
# then set to "false" to require verification.
AUTH_ALLOW_UNVERIFIED="true"

# Admin dashboard — comma-separated emails granted access to /admin
# (defaults to jeremy@lno.company if unset)
ADMIN_EMAILS="jeremy@lno.company"

# Public site URL (used in emails, links, redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Brevo — transactional email routing (https://www.brevo.com) ──
# Leave empty to disable email sending (sign-up still works; emails are logged).
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="jeremy@lno.company"
BREVO_SENDER_NAME="Crazy Bee Labs"

# ── Paddle — payments / billing (https://www.paddle.com) ── (wired in a later phase)
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_ENV="sandbox"        # "sandbox" or "production"

# ── LicenseGate — license generation / validation (https://licensegate.io) ── (later phase)
LICENSEGATE_API_KEY=""
LICENSEGATE_USER_ID=""
